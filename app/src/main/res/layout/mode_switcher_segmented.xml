<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mode_switcher_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/segmented_control_background"
    android:padding="2dp"
    android:layout_marginStart="@dimen/home_switcher_margin_h"
    android:layout_marginEnd="@dimen/home_switcher_margin_h"
    android:layout_marginTop="@dimen/home_switcher_margin_top"
    android:layout_marginBottom="4dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Moving active pill background behind text -->
    <View
        android:id="@+id/segment_active_indicator"
        android:layout_width="0dp"
        android:layout_height="@dimen/home_switcher_height"
        android:layout_gravity="top|start"
        android:background="@drawable/segment_active_background"
        android:visibility="invisible" />

    <!-- Segments Container -->
    <LinearLayout
        android:id="@+id/mode_switcher_segments"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- ShahidCam Segment -->
        <FrameLayout
            android:id="@+id/segment_shahidcam"
            android:layout_width="0dp"
            android:layout_height="@dimen/home_switcher_height"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:nextFocusUp="@+id/btn_top_more_menu"
            android:nextFocusDown="@+id/rowCamera"
            android:clipChildren="false"
            android:clipToPadding="false">

            <TextView
                android:id="@+id/text_shahidcam"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="ShahidCam"
                android:textStyle="bold"
                android:textSize="@dimen/home_switcher_text" />
        </FrameLayout>

        <!-- ScreenRec Segment -->
        <FrameLayout
            android:id="@+id/segment_shahidrec"
            android:layout_width="0dp"
            android:layout_height="@dimen/home_switcher_height"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:nextFocusUp="@+id/btn_top_more_menu"
            android:nextFocusDown="@+id/rowCamera"
            android:clipChildren="false"
            android:clipToPadding="false">

            <TextView
                android:id="@+id/text_shahidrec"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/mode_screenrec"
                android:textSize="@dimen/home_switcher_text" />
        </FrameLayout>

    </LinearLayout>
</FrameLayout>
