<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Unified White Claymorphism Application Theme -->
    <style name="Theme.ShahidCam.ClayLight" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:fontFamily">@font/ubuntu_regular</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>

        <!-- Primary & Accent Blue Tokens -->
        <item name="colorPrimary">@color/clay_accent_blue</item>
        <item name="colorPrimaryVariant">@color/clay_accent_blue_dark</item>
        <item name="colorSecondary">@color/clay_accent_blue</item>
        <item name="colorSecondaryVariant">@color/clay_accent_blue_dark</item>
        <item name="colorAccent">@color/clay_accent_blue</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Porcelain White & Off-White Surfaces -->
        <item name="android:colorBackground">@color/clay_bg_canvas</item>
        <item name="backgroundColor">@color/clay_bg_canvas</item>
        <item name="android:windowBackground">@color/clay_bg_canvas</item>
        <item name="android:windowBackgroundFallback">@color/clay_bg_canvas</item>
        <item name="android:colorBackgroundFloating">@color/clay_surface</item>
        <item name="colorSurface">@color/clay_surface</item>
        <item name="colorOnBackground">@color/clay_text_primary</item>
        <item name="colorOnSurface">@color/clay_text_primary</item>

        <!-- Custom ShahidCam Semantic Attributes -->
        <item name="colorTopBar">@color/clay_accent_blue</item>
        <item name="colorBottomNav">@color/clay_surface</item>
        <item name="colorHeading">@color/clay_text_primary</item>
        <item name="colorButton">@color/clay_accent_blue</item>
        <item name="colorToggle">@color/clay_accent_blue</item>
        <item name="colorSwitchTrack">@color/clay_border_strong</item>
        <item name="colorDialog">@color/clay_surface</item>
        <item name="colorStatusBar">@color/clay_accent_blue</item>
        <item name="sectionHeaderColor">@color/clay_accent_blue_dark</item>

        <!-- System Bars -->
        <item name="android:statusBarColor">@color/clay_accent_blue</item>
        <item name="android:navigationBarColor">@color/clay_bg_canvas</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">true</item>

        <!-- Text Hierarchy -->
        <item name="android:textColor">@color/clay_text_primary</item>
        <item name="android:textColorPrimary">@color/clay_text_primary</item>
        <item name="android:textColorSecondary">@color/clay_text_secondary</item>
        <item name="android:textColorTertiary">@color/clay_text_muted</item>

        <!-- Picker & Sheet Attributes (Light Claymorphism) -->
        <item name="pickerGradientStart">@color/clay_surface</item>
        <item name="pickerGradientMid">@color/clay_surface_alt</item>
        <item name="pickerGradientEnd">@color/clay_surface_inset</item>
        <item name="pickerTextPrimary">@color/clay_text_primary</item>
        <item name="pickerTextSecondary">@color/clay_text_secondary</item>
        <item name="pickerButtonBackground">@color/clay_accent_blue</item>
        <item name="pickerButtonText">@color/white</item>
        <item name="pickerIconTint">@color/clay_accent_blue</item>
        <item name="pickerSliderActive">@color/clay_accent_blue</item>
        <item name="pickerSliderInactive">@color/clay_border_strong</item>

        <!-- Home Control Rail Tokens -->
        <item name="homeRailBgStart">@color/clay_surface_inset</item>
        <item name="homeRailBgEnd">@color/clay_surface_inset</item>
        <item name="homeRailCardSurface">@color/clay_surface</item>
        <item name="homeRailCardBorder">@color/clay_border</item>
        <item name="homeRailCardStroke">@color/clay_border</item>
        <item name="homeRailTileSurface">@color/clay_surface</item>
        <item name="homeRailSegmentedSurface">@color/clay_surface_inset</item>
        <item name="homeRailSegmentedBorder">@color/clay_border</item>
        <item name="homeRailSegmentActive">@color/clay_accent_blue</item>
        <item name="homeRailSegmentActiveText">@color/white</item>
        <item name="homeRailTextPrimary">@color/clay_text_primary</item>
        <item name="homeRailTextSecondary">@color/clay_text_secondary</item>
        <item name="homeRailAccent">@color/clay_accent_blue</item>

        <!-- Component Styles -->
        <item name="toolbarStyle">@style/Widget.ShahidCam.Toolbar</item>
        <item name="bottomNavigationStyle">@style/Widget.ShahidCam.BottomNavigationView</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.ShahidCam.Dialog</item>
        <item name="android:dialogTheme">@style/ThemeOverlay.ShahidCam.Dialog</item>
        <item name="bottomSheetDialogTheme">@style/CustomBottomSheetDialogTheme</item>
        <item name="cardViewStyle">@style/Theme.ShahidCam.ClayCardView</item>
        <item name="switchStyle">@style/Widget.ShahidCam.Switch</item>
        <item name="materialSwitchStyle">@style/Widget.ShahidCam.Switch</item>
    </style>

    <style name="Base.Theme.ShahidCam" parent="Theme.ShahidCam.ClayLight" />

    <!-- Lightweight White Claymorphism Splash Theme (no dark flash, no artificial wait) -->
    <style name="Theme.ShahidCam.Splash" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/clay_bg_canvas</item>
        <item name="windowSplashScreenBackground">@color/clay_bg_canvas</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_shahidcam_avatar</item>
        <item name="android:statusBarColor">@color/clay_bg_canvas</item>
        <item name="android:navigationBarColor">@color/clay_bg_canvas</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="postSplashScreenTheme">@style/Theme.ShahidCam.ClayLight</item>
    </style>

    <style name="Theme.ShahidCam.ClayCardView" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/clay_surface</item>
        <item name="cardElevation">3dp</item>
        <item name="cardCornerRadius">18dp</item>
    </style>

    <!-- Legacy theme aliases unified onto White Claymorphism -->
    <style name="Theme.ShahidCam.Amoled" parent="Theme.ShahidCam.ClayLight" />
    <style name="Theme.ShahidCam.AmoledCardView" parent="Theme.ShahidCam.ClayCardView" />
    <style name="Theme.ShahidCam.AmoledBottomNavigation" parent="Widget.ShahidCam.BottomNavigationView" />
    <style name="ThemeOverlay.ShahidCam.Amoled.MaterialAlertDialog" parent="ThemeOverlay.ShahidCam.Dialog" />
    <style name="AmoledDialogButton" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/clay_accent_blue</item>
    </style>
    <style name="Theme.ShahidCam.Red" parent="Theme.ShahidCam.ClayLight" />
    <style name="ThemeOverlay.ShahidCam.Red.Dialog" parent="ThemeOverlay.ShahidCam.Dialog" />
    <style name="Widget.ShahidCam.Red.Button" parent="Widget.ShahidCam.Button" />
    <style name="Widget.ShahidCam.Red.PopupMenu" parent="Widget.ShahidCam.PopupMenu" />
    <style name="Theme.ShahidCam.Gold" parent="Theme.ShahidCam.ClayLight" />
    <style name="ThemeOverlay.ShahidCam.Gold.Dialog" parent="ThemeOverlay.ShahidCam.Dialog" />
    <style name="Widget.ShahidCam.Gold.Button" parent="Widget.ShahidCam.Button" />
    <style name="Widget.ShahidCam.Gold.PopupMenu" parent="Widget.ShahidCam.PopupMenu" />
    <style name="Theme.ShahidCam.SilentForest" parent="Theme.ShahidCam.ClayLight" />
    <style name="ThemeOverlay.ShahidCam.SilentForest.Dialog" parent="ThemeOverlay.ShahidCam.Dialog" />
    <style name="Widget.ShahidCam.SilentForest.Button" parent="Widget.ShahidCam.Button" />
    <style name="Widget.ShahidCam.SilentForest.PopupMenu" parent="Widget.ShahidCam.PopupMenu" />
    <style name="Theme.ShahidCam.ShadowAlloy" parent="Theme.ShahidCam.ClayLight" />
    <style name="ThemeOverlay.ShahidCam.ShadowAlloy.Dialog" parent="ThemeOverlay.ShahidCam.Dialog" />
    <style name="Widget.ShahidCam.ShadowAlloy.Button" parent="Widget.ShahidCam.Button" />
    <style name="Widget.ShahidCam.ShadowAlloy.PopupMenu" parent="Widget.ShahidCam.PopupMenu" />
    <style name="Theme.ShahidCam.PookiePink" parent="Theme.ShahidCam.ClayLight" />
    <style name="ThemeOverlay.ShahidCam.PookiePink.Dialog" parent="ThemeOverlay.ShahidCam.Dialog" />
    <style name="Widget.ShahidCam.PookiePink.Button" parent="Widget.ShahidCam.Button" />
    <style name="Widget.ShahidCam.PookiePink.PopupMenu" parent="Widget.ShahidCam.PopupMenu" />
    <style name="Theme.ShahidCam.SnowVeil" parent="Theme.ShahidCam.ClayLight" />
    <style name="Theme.ShahidCam.SnowVeilCardView" parent="Theme.ShahidCam.ClayCardView" />
    <style name="Widget.ShahidCam.SnowVeil.Switch" parent="Widget.ShahidCam.Switch" />
    <style name="Widget.ShahidCam.SnowVeil.Checkbox" parent="Widget.MaterialComponents.CompoundButton.CheckBox">
        <item name="buttonTint">@color/clay_accent_blue</item>
    </style>
    <style name="Widget.ShahidCam.SnowVeil.RadioButton" parent="Widget.MaterialComponents.CompoundButton.RadioButton">
        <item name="buttonTint">@color/clay_accent_blue</item>
    </style>
    <style name="ThemeOverlay.ShahidCam.SnowVeil.Dialog" parent="ThemeOverlay.ShahidCam.Dialog" />
    <style name="Widget.ShahidCam.SnowVeil.Button" parent="Widget.ShahidCam.Button" />
    <style name="Widget.ShahidCam.SnowVeil.PopupMenu" parent="Widget.ShahidCam.PopupMenu" />
    <style name="ThemeOverlay.ShahidCam.SnowVeil.BottomSheet" parent="ThemeOverlay.ShahidCam.BottomSheet" />
    <style name="Theme.ShahidCam.MidnightDusk" parent="Theme.ShahidCam.ClayLight" />

    <style name="Widget.ShahidCam.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/clay_accent_blue</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <style name="Widget.ShahidCam.PopupMenu" parent="Widget.Material3.PopupMenu">
        <item name="android:popupBackground">@color/clay_surface</item>
        <item name="android:textColor">@color/clay_text_primary</item>
    </style>

    <style name="Widget.ShahidCam.Switch" parent="Widget.MaterialComponents.CompoundButton.Switch">
        <item name="thumbTint">@color/switch_thumb</item>
        <item name="trackTint">@color/switch_track</item>
    </style>

    <style name="Widget.ShahidCam.Toolbar" parent="Widget.MaterialComponents.Toolbar">
        <item name="android:background">@color/clay_accent_blue</item>
        <item name="titleTextColor">@android:color/white</item>
        <item name="subtitleTextColor">@android:color/white</item>
    </style>

    <style name="Widget.ShahidCam.Toolbar.Light" parent="Widget.ShahidCam.Toolbar" />

    <style name="Widget.ShahidCam.BottomNavigationView" parent="Widget.Material3.BottomNavigationView">
        <item name="android:minHeight">64dp</item>
        <item name="android:background">@color/clay_surface</item>
        <item name="itemIconTint">@color/bottom_nav_icon_tint</item>
        <item name="itemTextColor">@color/clay_accent_blue</item>
        <item name="itemActiveIndicatorStyle">@null</item>
        <item name="labelVisibilityMode">selected</item>
    </style>

    <style name="Widget.ShahidCam.BottomNavigationView.Light" parent="Widget.ShahidCam.BottomNavigationView" />

    <style name="TextAppearance.ShahidCam.BottomNav.Active" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">10sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:includeFontPadding">true</item>
    </style>

    <style name="TextAppearance.ShahidCam.BottomNav.Inactive" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">10sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:includeFontPadding">true</item>
    </style>

    <style name="ThemeOverlay.ShahidCam.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="android:background">@color/clay_surface</item>
        <item name="android:textColor">@color/clay_text_primary</item>
        <item name="android:textColorPrimary">@color/clay_text_primary</item>
        <item name="android:textColorSecondary">@color/clay_text_secondary</item>
        <item name="colorPrimary">@color/clay_accent_blue</item>
        <item name="colorOnPrimary">@color/white</item>
    </style>

    <style name="ThemeOverlay.ShahidCam.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:background">@color/clay_surface</item>
        <item name="colorSurface">@color/clay_surface</item>
        <item name="android:textColor">@color/clay_text_primary</item>
        <item name="android:textColorPrimary">@color/clay_text_primary</item>
        <item name="android:textColorSecondary">@color/clay_text_secondary</item>
        <item name="colorPrimary">@color/clay_accent_blue</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="materialAlertDialogTitleTextStyle">@style/MaterialAlertDialog.Title</item>
        <item name="materialAlertDialogBodyTextStyle">@style/MaterialAlertDialog.Body</item>
    </style>

    <style name="Theme.ShahidCam.TransparentDialog" parent="Theme.Material3.DayNight.Dialog.Alert">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="colorPrimary">@color/clay_accent_blue</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSurface">@color/clay_surface</item>
        <item name="colorOnSurface">@color/clay_text_primary</item>
        <item name="android:textColorPrimary">@color/clay_text_primary</item>
        <item name="android:textColorSecondary">@color/clay_text_secondary</item>
        <item name="materialAlertDialogTitleTextStyle">@style/MaterialAlertDialog.Title</item>
        <item name="materialAlertDialogBodyTextStyle">@style/MaterialAlertDialog.Body</item>
    </style>

    <style name="MaterialAlertDialog.Title" parent="MaterialAlertDialog.MaterialComponents.Title.Text">
        <item name="android:textColor">@color/clay_text_primary</item>
        <item name="fontFamily">@font/ubuntu_regular</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="MaterialAlertDialog.Body" parent="MaterialAlertDialog.MaterialComponents.Body.Text">
        <item name="android:textColor">@color/clay_text_secondary</item>
        <item name="fontFamily">@font/ubuntu_regular</item>
    </style>

    <!-- Wear OS dedicated theme kept dark for OLED round watches -->
    <style name="Theme.ShahidCam.WatchCompat" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/black</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:fontFamily">@font/ubuntu_regular</item>
        <item name="colorPrimary">@color/clay_accent_blue</item>
        <item name="colorPrimaryVariant">@color/clay_accent_blue_dark</item>
        <item name="colorSecondary">@color/clay_accent_blue</item>
        <item name="colorSecondaryVariant">@color/clay_accent_blue_dark</item>
        <item name="colorSurface">@color/black</item>
        <item name="colorOnSurface">@android:color/white</item>
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textColorPrimary">@android:color/white</item>
        <item name="android:textColorSecondary">#BDBDBD</item>
    </style>

</resources>
