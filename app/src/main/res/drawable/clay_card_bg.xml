<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/clay_shadow_rim" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item android:bottom="2.5dp" android:right="1dp" android:left="1dp" android:top="0.5dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/clay_surface" />
            <stroke android:width="1dp" android:color="@color/clay_card_stroke_subtle" />
            <corners android:radius="19dp" />
        </shape>
    </item>
</layer-list>
