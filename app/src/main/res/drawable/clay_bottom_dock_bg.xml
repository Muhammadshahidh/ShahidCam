<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/clay_dock_shadow" />
            <corners android:radius="26dp" />
        </shape>
    </item>
    <item android:bottom="3dp" android:top="0.5dp" android:left="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/clay_surface" />
            <stroke android:width="1dp" android:color="@color/clay_dock_stroke" />
            <corners android:radius="25dp" />
        </shape>
    </item>
</layer-list>
