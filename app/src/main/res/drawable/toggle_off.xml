<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="52dp"
    android:height="52dp"
    android:viewportWidth="400"
    android:viewportHeight="400">

    <path
        android:name="head"
        android:pathData="M 30,200 A 170,170 0 1,0 370,200 A 170,170 0 1,0 30,200 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="135"
                android:centerY="110"
                android:gradientRadius="265"
                android:startColor="#5c646e"
                android:centerColor="#24282e"
                android:endColor="#0d0e11" />
        </aapt:attr>
    </path>

    <path
        android:name="specular_sheen"
        android:pathData="M 70,135 A 130,130 0 0,1 270,75 A 160,160 0 0,0 70,135 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="70"
                android:startY="135"
                android:endX="270"
                android:endY="75"
                android:startColor="#35ffffff"
                android:endColor="#00ffffff" />
        </aapt:attr>
    </path>

    <group
        android:name="eye_group"
        android:translateX="0"
        android:translateY="18"
        android:pivotX="200"
        android:pivotY="165"
        android:scaleY="1.0">
        <path
            android:name="left_eye"
            android:pathData="M 90,165 A 40,40 0 0 0 170,165 Z"
            android:fillColor="#22262b"
            android:fillAlpha="1" />
        <path
            android:name="right_eye"
            android:pathData="M 230,165 A 40,40 0 0 0 310,165 Z"
            android:fillColor="#22262b"
            android:fillAlpha="1" />
    </group>
</vector>
