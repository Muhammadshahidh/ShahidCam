<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/clay_top_bar_bottom" />
            <corners android:bottomLeftRadius="26dp" android:bottomRightRadius="26dp" />
        </shape>
    </item>
    <item android:bottom="2.5dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="@color/clay_top_bar_start"
                android:endColor="@color/clay_top_bar_end" />
            <corners android:bottomLeftRadius="25dp" android:bottomRightRadius="25dp" />
        </shape>
    </item>
</layer-list>
